<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Allow plain HTTP only to the Android emulator's loopback alias to
         your host machine, for local `next dev` testing (10.0.2.2 is the
         emulator's special alias for the host's 127.0.0.1). Never matches
         real devices or production domains. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
